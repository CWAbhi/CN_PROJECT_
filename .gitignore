# macOS artifacts
.DS_Store
.AppleDouble
.LSOverride
._*

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Nginx runtime logs and pid files
*.log
nginx.pid
nginx-access.log
nginx-error.log
cache/
Mac 2 - Edge/cache/

